on init
    # I/O scheduler
    write /sys/block/sda/queue/scheduler ssg
    write /sys/block/sdb/queue/scheduler ssg
    write /sys/block/sdc/queue/scheduler ssg
    write /sys/block/sdd/queue/scheduler ssg
    write /sys/block/sde/queue/scheduler ssg
    write /sys/block/sdf/queue/scheduler ssg

# Stock battery anti-aging runs once at boot and tunes the charge voltage
# from the battery's cycle count and health. The stock power-off charging
# service and its charger fstab are left out.
on post-fs-data
    mkdir /data/vendor/batteryantiaging 0770 system system
    # Persist is mounted by the non-late fstab pass before post-fs-data. Read
    # the body colour before framework services start and select their
    # default wallpaper.
    exec_start piano-body-color

service batteryantiaging /vendor/bin/hw/vendor.xiaomi.hardware.batteryantiaging-service
    interface aidl vendor.xiaomi.hardware.batteryantiaging.IBatteryAntiAging/default
    class hal
    user root
    group system
    oneshot

service piano-body-color /vendor/bin/piano-body-color.sh
    user system
    group system
    disabled
    oneshot

on boot
    # libperfmgr runs as system and writes these nodes.
    chown system system /sys/devices/system/cpu/cpufreq/policy0/walt/adaptive_high_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/walt/adaptive_high_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy6/walt/adaptive_high_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy6/walt/adaptive_high_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy0/walt/adaptive_low_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/walt/adaptive_low_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy6/walt/adaptive_low_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy6/walt/adaptive_low_freq
    chown system system /proc/sys/walt/sched_boost
    chmod 0664 /proc/sys/walt/sched_boost
    chown system system /proc/sys/walt/sched_busy_hysteresis_enable_cpus
    chmod 0664 /proc/sys/walt/sched_busy_hysteresis_enable_cpus
    chown system system /proc/sys/walt/sched_min_task_util_for_boost
    chmod 0664 /proc/sys/walt/sched_min_task_util_for_boost
    chown system system /proc/sys/walt/sched_min_task_util_for_colocation
    chmod 0664 /proc/sys/walt/sched_min_task_util_for_colocation
    chown system system /proc/sys/walt/cluster0/smart_freq/ipc_freq_levels
    chmod 0664 /proc/sys/walt/cluster0/smart_freq/ipc_freq_levels
    chown system system /proc/sys/walt/cluster1/smart_freq/ipc_freq_levels
    chmod 0664 /proc/sys/walt/cluster1/smart_freq/ipc_freq_levels
    chown system system /sys/devices/system/cpu/cpu0/core_ctl/min_cpus
    chmod 0664 /sys/devices/system/cpu/cpu0/core_ctl/min_cpus
    chown system system /sys/devices/system/cpu/cpu6/core_ctl/min_cpus
    chmod 0664 /sys/devices/system/cpu/cpu6/core_ctl/min_cpus
    chown system system /sys/kernel/msm_performance/parameters/cpu_min_freq
    chmod 0664 /sys/kernel/msm_performance/parameters/cpu_min_freq
    chown system system /sys/devices/system/cpu/bus_dcvs/LLCC/240b3400.qcom,bwmon-llcc-gold/min_freq
    chmod 0664 /sys/devices/system/cpu/bus_dcvs/LLCC/240b3400.qcom,bwmon-llcc-gold/min_freq
    chown system system /sys/devices/system/cpu/bus_dcvs/LLCC/240b7400.qcom,bwmon-llcc-prime/min_freq
    chmod 0664 /sys/devices/system/cpu/bus_dcvs/LLCC/240b7400.qcom,bwmon-llcc-prime/min_freq
    chown system system /sys/devices/system/cpu/bus_dcvs/LLCC/240b3400.qcom,bwmon-llcc-gold/max_freq
    chmod 0664 /sys/devices/system/cpu/bus_dcvs/LLCC/240b3400.qcom,bwmon-llcc-gold/max_freq
    chown system system /sys/devices/system/cpu/bus_dcvs/LLCC/240b7400.qcom,bwmon-llcc-prime/max_freq
    chmod 0664 /sys/devices/system/cpu/bus_dcvs/LLCC/240b7400.qcom,bwmon-llcc-prime/max_freq
    chown system system /sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:gold/min_freq
    chmod 0664 /sys/devices/system/cpu/bus_dcvs/DDR/soc:qcom,memlat:ddr:gold/min_freq
    chown system system /sys/class/kgsl/kgsl-3d0/min_pwrlevel
    chmod 0664 /sys/class/kgsl/kgsl-3d0/min_pwrlevel
    chown system system /sys/class/touch/touch_dev/double_tap
    chmod 0664 /sys/class/touch/touch_dev/double_tap

on property:sys.boot_completed=1
    # Start processing power hints once boot is done.
    setprop vendor.powerhal.init 1
