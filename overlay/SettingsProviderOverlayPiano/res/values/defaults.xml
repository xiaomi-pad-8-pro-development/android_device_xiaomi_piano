<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Keep the on-screen keyboard available while the keyboard cover is
         attached, for when its keys are ignored (folded behind the tablet or
         in tent position). The cover's input devices only exist while it is
         attached. -->
    <bool name="def_show_ime_with_hard_keyboard">true</bool>

    <!-- Tablet: follow the accelerometer by default so landscape works out of
         the box. -->
    <bool name="def_accelerometer_rotation">true</bool>

    <!-- Landscape (ROTATION_90) when auto-rotate is off. -->
    <integer name="def_user_rotation">1</integer>
</resources>
