type hal_quickcamera_service, hal_service_type, protected_service, service_manager_type;

binder_call(hal_quickcamera, platform_app)
binder_call(hal_quickcamera, priv_app)
binder_call(hal_quickcamera, system_app)
binder_call(hal_quickcamera, system_server)
binder_call(hal_quickcamera_client, hal_quickcamera_server)
allow hal_quickcamera_client hal_quickcamera_service:service_manager find;
binder_call(hal_quickcamera_server, hal_quickcamera_client)
allow hal_quickcamera_server hal_quickcamera_service:service_manager { add find };
